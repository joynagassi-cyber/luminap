{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitAny": false,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "nitro.config.ts"],
  "exclude": ["node_modules", "dist"],
  "baseUrl": ".",
  "paths": {
    "@/store": ["server/store"]
  }
}
