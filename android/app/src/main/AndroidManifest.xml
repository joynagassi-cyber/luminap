<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Capacitor 8 impose minSdk 24 (Android 7.0). Le AAR OneSignal (4.x) et
         le framework Cordova résiduel peuvent déclarer un minSdk inférieur :
         l'override reste nécessaire pour que le manifest merger n'échoue pas.
         (@capacitor-community/sqlite — stockage SQLite natif de PowerSync —
         exige l'API 24, satisfaite par le nouveau minSdk.) -->
    <uses-sdk tools:overrideLibrary="com.onesignal,org.apache.cordova,io.ionic.libs.ionfilesystemlib" />

    <!-- allowBackup="false" (A1 / C-07a) : la base SQLite locale
         (données financières de tiers), les jetons de session et le
         localStorage ne doivent jamais partir en sauvegarde Google /
         `adb backup`. La sauvegarde utilisateur passe par l'export
         manuel de l'application. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name="com.lumina.mfejc.MainActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase / Google OAuth deep-link callback.
                 When signInWithOAuth() is called with redirectTo =
                 "lumina://auth/callback", Google hands the browser/WebView
                 back to this scheme and Android routes it straight into the
                 app instead of opening the system browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumina" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM (Firebase Cloud Messaging) — required by OneSignal for in-app
             push delivery on modern Android. -->
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:enabled="true"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Self-updater : receiver du résultat de la session PackageInstaller
             (confirmé par la mission ; exporté=false = interne à l'app). -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- USE_FULL_SCREEN_INTENT retirée (A1 / P-03) : aucun usage plein
         écran dans une app de gestion ; permission restreinte depuis
         Android 14 (refus Play Store hors appels/alarmes). Ne pas
         réintroduire sans besoin documenté (matrice §1.2 de
         docs/lumina-ionic-capacitor-permissions.md). -->
    <!-- FCM (Firebase Cloud Messaging) — required by OneSignal for in-app
         push delivery on modern Android. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Self-updater : permet à l'app de demander l'installation d'APK
         (sources inconnues) via PackageInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
