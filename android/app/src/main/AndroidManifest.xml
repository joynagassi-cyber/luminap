<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lumina vise minSdk 21 (téléphones simples / anciens). Le AAR
         OneSignal et le framework Cordova résiduel déclarent minSdk 22, et
         le AAR ionfilesystem (dépendance d'@capacitor/filesystem, exports
         P0-2) déclare minSdk 23 : force l'override pour que le manifest
         merger n'échoue pas. -->
    <uses-sdk tools:overrideLibrary="com.onesignal,org.apache.cordova,io.ionic.libs.ionfilesystemlib" />

    <!-- C-07a — AUCUNE sauvegarde : la base SQLite locale (transactions,
         caisses, membres) et les Preferences/localStorage (jetons de session
         non chiffrés) ne doivent jamais partir vers Google Drive / adb backup /
         un transfert d'appareil. Défense en profondeur : allowBackup=false ET
         des règles d'exclusion explicites pour API 23-30 et API 31+.
         Vérification : `adb backup -f /tmp/l.apk -apk com.lumina.mfejc` puis
         `tar tf /tmp/l.apk` ne doit contenir aucune base ni préférence. -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name="com.lumina.mfejc.MainActivity"
            android:label="@string/app_name"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase / Google OAuth deep-link callback.
                 When signInWithOAuth() is called with redirectTo =
                 "lumina://auth/callback", Google hands the browser/WebView
                 back to this scheme and Android routes it straight into the
                 app instead of opening the system browser. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lumina" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- FCM (Firebase Cloud Messaging) — required by OneSignal for in-app
             push delivery on modern Android. -->
        <service
            android:name="com.google.firebase.messaging.FirebaseMessagingService"
            android:enabled="true"
            android:exported="true"
            tools:replace="android:exported">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Self-updater : receiver du résultat de la session PackageInstaller
             (confirmé par la mission ; exporté=false = interne à l'app). -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Notifications : permission d'EXÉCUTION depuis Android 13 (API 33).
          Déclarée ici, mais demandée UNIQUEMENT par
         `src/lib/permissions/permissionService.ts` (via
         `@capacitor/push-notifications`), après un écran d'explication —
         jamais au démarrage à froid. Avant Android 13 elle est accordée
         silencieusement. Voir docs/lumina-ionic-capacitor-permissions.md §1.2. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Self-updater : permet à l'app de demander l'installation d'APK
         (sources inconnues) via PackageInstaller.
         P-03/C-08 : `USE_FULL_SCREEN_INTENT` a été RETIRÉE (aucun usage :
         Lumina n'est ni une sonnerie ni une alarme ; permission restreinte
         sur Android 14+, motif de refus Play).
         Distribution : `REQUEST_INSTALL_PACKAGES` reste JUSTIFIÉE tant que
         la distribution se fait par APK direct (décision §1.5 non tranchée).
         Si passage au Play Store : retirer cette ligne, `ApkUpdaterPlugin`
         et `src/updater/`. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

</manifest>
