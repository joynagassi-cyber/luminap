<?xml version="1.0" encoding="utf-8"?>
<!--
  C-07a — API 31+ : ni sauvegarde cloud, ni transfert appareil-à-appareil.
  Voir backup_rules.xml pour le raisonnement (données financières de tiers,
  jetons de session non chiffrés).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
        <exclude domain="cache" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
        <exclude domain="cache" path="." />
    </device-transfer>
</data-extraction-rules>
