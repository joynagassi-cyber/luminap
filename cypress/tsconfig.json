{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "types": [
      "cypress",
      "node"
    ],
    "baseUrl": "..",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "target": "ES2020",
    "composite": true,
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "../cypress.config.ts"
  ]
}
